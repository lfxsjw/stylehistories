---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
}

const { title, description, image, type = 'website', publishedTime } = Astro.props;
const siteName = 'Dressed in History';
const siteDesc = description || 'The stories behind what we wear — a daily fashion history journal.';

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || '';
const defaultImage = `${siteUrl}/images/little-black-dress.jpg`;
const ogImage = image ? (image.startsWith('http') ? image : `${siteUrl}${image}`) : defaultImage;
const canonical = new URL(Astro.url.pathname, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  url: siteUrl,
  description: 'The stories behind what we wear — a daily fashion history journal.',
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — {siteName}</title>
    <meta name="description" content={siteDesc} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />

    <!-- 社交分享卡（Facebook / X / LinkedIn） -->
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={`${title} — ${siteName}`} />
    <meta property="og:description" content={siteDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} — ${siteName}`} />
    <meta name="twitter:description" content={siteDesc} />
    <meta name="twitter:image" content={ogImage} />

    <!-- 结构化数据（Google 富摘要） -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- 时尚杂志字体：Bodoni Moda（Vogue 同源气质）+ Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..700;1,6..96,400..600&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="masthead">
      <div class="container">
        <p class="mast-overline">A Daily Fashion History Journal</p>
        <a href="/" class="mast-logo">Dressed<em>in</em>History</a>
        <nav>
          <a href="/">Home</a>
          <a href="/#categories">Categories</a>
          <a href="/about">About</a>
          <a href="/contact">Contact</a>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-brand">
            <div class="mast-logo">Dressed<em>in</em>History</div>
            <p>
              The trench coat was born in a war. Blue jeans were riveted for Gold
              Rush miners. Every garment has a story — we publish one every day.
            </p>
          </div>

          <div class="footer-col">
            <h4>Explore</h4>
            <a href="/">All Stories</a>
            <a href="/category/icons/">Icons</a>
            <a href="/category/denim/">Denim</a>
            <a href="/category/outerwear/">Outerwear</a>
          </div>

          <div class="footer-col">
            <h4>The Journal</h4>
            <a href="/about">About Us</a>
            <a href="/about#editorial">Editorial Approach</a>
            <a href="/contact">Get in Touch</a>
            <a href="/subscribe">Subscribe (RSS)</a>
          </div>

          <div class="footer-col">
            <h4>Legal &amp; Credits</h4>
            <a href="/privacy">Privacy Policy</a>
            <a href="/disclosure">Affiliate Disclosure</a>
            <a href="/credits">Image Credits</a>
          </div>
        </div>

        <div class="footer-bottom">
          <span>© {new Date().getFullYear()} Dressed in History</span>
          <span>All images belong to their respective owners</span>
        </div>
      </div>
    </footer>
  </body>
</html>
