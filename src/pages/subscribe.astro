---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || '';
const feedUrl = `${siteUrl}/rss.xml`;

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Layout title="Subscribe" description="Subscribe to Dressed in History via RSS — new stories every day, no algorithm.">
  <main class="article">
    <div class="container article-inner">
      <a href="/" class="back-link">All Stories</a>

      <header class="article-header">
        <p class="kicker">Subscribe</p>
        <h1 class="page-title">Never miss a story</h1>
        <p class="page-deck">New stories every day — no algorithm, no noise.</p>
      </header>

      <div class="prose">
        <p>
          The easiest way to follow this journal is <strong>RSS</strong> — a quiet,
          open technology that has delivered new articles to readers for twenty
          years. No account, no tracking, no feed deciding what you should see.
        </p>

        <h2>How to subscribe</h2>
        <ol>
          <li>Download an RSS reader — <a href="https://feedly.com" rel="noopener">Feedly</a>, <a href="https://netnewswire.com" rel="noopener">NetNewsWire</a> (free, Mac &amp; iOS), or <a href="https://www.inoreader.com" rel="noopener">Inoreader</a>.</li>
          <li>Copy the feed address below.</li>
          <li>Paste it into your reader. Done — every new story arrives automatically.</li>
        </ol>

        <p style="font-family: var(--sans); font-size: 0.8rem; background: var(--paper-deep); border: 1px solid var(--hairline); border-radius: 4px; padding: 12px 16px; word-break: break-all;">
          <strong>Feed address:</strong> {feedUrl}
        </p>

        <h2>Recent stories in the feed</h2>
      </div>

      <div style="margin-top: 10px;">
        {posts.map((post) => (
          <article style="border-top: 1px solid var(--hairline); padding: 22px 0;">
            <p class="meta" style="font-family: var(--sans); font-size: 0.64rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--faint); margin-bottom: 8px;">
              {formatDate(post.data.pubDate)} · {post.data.category}
            </p>
            <h2 style="font-size: 1.35rem; font-weight: 500; line-height: 1.3; margin-bottom: 6px;">
              <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
            </h2>
            <p style="font-style: italic; color: var(--muted); font-size: 0.98rem;">{post.data.description}</p>
          </article>
        ))}
      </div>

      <a href="/" class="back-link bottom">All Stories</a>
    </div>
  </main>
</Layout>
