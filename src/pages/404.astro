---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found" description="The page you are looking for could not be found.">
  <main class="article">
    <div class="container article-inner" style="text-align: center; padding: 90px 0 110px;">
      <p class="kicker" style="font-family: var(--sans); font-size: 0.66rem; font-weight: 600; letter-spacing: 0.3em; text-transform: uppercase; color: var(--accent); margin-bottom: 20px;">
        Error 404
      </p>
      <h1 style="font-family: var(--serif); font-size: clamp(2.4rem, 5vw, 3.6rem); font-weight: 500; line-height: 1.1; margin-bottom: 20px;">
        This page has<br /><em style="font-style: italic;">gone out of fashion</em>
      </h1>
      <p style="font-style: italic; font-size: 1.15rem; color: var(--muted); margin-bottom: 44px;">
        The story you are looking for may have been moved, renamed, or never existed.
      </p>
      <a href="/" class="back-link" style="margin: 0;">Back to all stories</a>
    </div>
  </main>
</Layout>
