---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact" description="Get in touch with Dressed in History.">
  <main class="article">
    <div class="container article-inner">
      <a href="/" class="back-link">All Stories</a>

      <header class="article-header">
        <p class="kicker">Contact</p>
        <h1 class="page-title">Get in touch</h1>
        <p class="page-deck">Questions, ideas, partnerships — we read everything.</p>
      </header>

      <div class="prose">
        <p>
          Have a question, a story tip, or a garment you think deserves its own
          article? We would be glad to hear from you.
        </p>
        <p>
          <strong>Email:</strong>
          <a href="mailto:hello@stylehistories.com">hello@stylehistories.com</a>
        </p>
        <p>
          We read every message and try to reply within a couple of days.
        </p>
        <p>
          For brand partnerships, affiliate inquiries, or press, please mention
          <em>&ldquo;Partnership&rdquo;</em> in your subject line.
        </p>
      </div>

      <a href="/" class="back-link bottom">All Stories</a>
    </div>
  </main>
</Layout>
