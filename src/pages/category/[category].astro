---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const categories = [...new Set(posts.map((p) => p.data.category))];
  return categories.map((cat) => ({
    params: { category: cat.toLowerCase() },
    props: {
      category: cat,
      posts: posts
        .filter((p) => p.data.category === cat && !p.data.draft)
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
      allCategories: categories,
    },
  }));
}

const { category, posts, allCategories } = Astro.props;

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

function readingTime(body: string): number {
  return Math.max(1, Math.ceil(body.split(/\s+/).length / 200));
}
---

<Layout title={`${category} — Category`} description={`Fashion history stories about ${category}.`}>
  <div class="container">
    <div class="cat-hero">
      <p class="kicker">Category</p>
      <h1>{category}</h1>
      <p class="cat-count">
        {posts.length} {posts.length === 1 ? 'story' : 'stories'} in this collection
      </p>
    </div>

    <nav class="category-bar">
      <a href="/">All Stories</a>
      {allCategories.map((cat) => (
        <a
          href={`/category/${cat.toLowerCase()}/`}
          class={cat === category ? 'is-active' : ''}
        >
          {cat}
        </a>
      ))}
    </nav>

    <div class="post-grid" style="margin-top: 48px; padding-bottom: 70px;">
      {posts.map((post) => (
        <article class="post-item">
          <a href={`/blog/${post.slug}/`} class="post-link">
            <div class="post-media">
              {post.data.heroImage && (
                <img src={post.data.heroImage} alt={post.data.title} />
              )}
            </div>
            <p class="kicker">{post.data.category}</p>
            <h2>{post.data.title}</h2>
            <p class="excerpt">{post.data.description}</p>
            <p class="meta">
              {formatDate(post.data.pubDate)} · {readingTime(post.body)} min read
            </p>
          </a>
        </article>
      ))}
    </div>
  </div>
</Layout>
